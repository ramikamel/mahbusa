{
  "name": "mahbusa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:engine": "node --test tests/engine.node.test.mjs tests/benchmark-cli.node.test.mjs tests/self-play-cli.node.test.mjs tests/prepare-training.node.test.mjs tests/model-parity.node.test.mjs tests/model-artifact.node.test.mjs tests/model-play.node.test.mjs tests/opponent-pool.node.test.mjs",
    "benchmark:bot": "node scripts/benchmark-bot.mjs",
    "selfplay:bot": "node scripts/self-play-bot.mjs",
    "prepare:training": "node scripts/prepare-training.mjs",
    "verify:model-parity": "node scripts/verify-model-parity.mjs",
    "test:offline": "node --test tests/offline.node.test.mjs",
    "build": "vite build && node scripts/offline.mjs",
    "build:worker-smoke": "node scripts/build-worker-smoke.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": { "svelte": "^5.39.0" },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.0",
    "@types/node": "^22.18.0",
    "svelte-check": "^4.3.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  },
  "engines": { "node": ">=22.18.0" }
}
